[Unit]
Description=Watch for a serial2moon update-check request
Documentation=https://github.com/Lukas-Heiligenbrunner/serial2moon

[Path]
# serial2moon (in its container) drops this file when the HOST_UPDATE_CHECK macro runs.
PathExists=/run/serial2moon/update-check
Unit=serial2moon-update-check.service

[Install]
WantedBy=multi-user.target
